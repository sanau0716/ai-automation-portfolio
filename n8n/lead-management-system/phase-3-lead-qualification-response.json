            {
              "id": "466ac35e-4bed-4b7c-ba12-1c251ddf050a",
              "leftValue": "={{ $json.lead_score }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
