      "name": "Get Leads from Database"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  const classification = item.json.classification;\n\n  return (\n    classification === 'High-Value Lead' ||\n    classification === 'Qualified Lead'\n  );\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        128
      ],
      "id": "c9b55a3c-71c1-4f25-ad9a-59af1690aa10",
      "name": "Filter Eligible Leads"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nreturn $input.all().filter(item => {\n  const lead = item.json;\n\n  // New leads have not been contacted yet\n  if (!lead[\"Last Contacted\"]) {\n    return lead.Status === \"New\";\n  }\n\n  const lastContacted = new Date(lead[\"Last Contacted\"]);\n  const hoursSinceContact =\n    (now - lastContacted) / (1000 * 60 * 60);\n\n  // Follow up after 24 hours\n  return hoursSinceContact >= 24;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        128
      ],
      "id": "c242b064-9259-426c-a467-2c167c5d526d",
      "name": "Check Follow-Up Eligibility"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const output = $json.output || '';\n\nconst followUpType =\n  output.match(/FOLLOW_UP_TYPE:\\s*(.*)/)?.[1]?.trim() || '';\n\nconst priority =\n  output.match(/PRIORITY:\\s*(.*)/)?.[1]?.trim() || '';\n\nconst subject =\n  output.match(/SUBJECT:\\s*(.*)/)?.[1]?.trim() || '';\n\nconst messageMatch =\n  output.match(/MESSAGE:\\s*([\\s\\S]*?)(?=\\nMESSAGE:|\\nRECOMMENDATION:|$)/);\n\nconst message =\n  messageMatch?.[1]?.trim() || '';\n\nconst recommendation =\n  output.match(/RECOMMENDATION:\\s*([\\s\\S]*)/)?.[1]?.trim() || '';\n\nconst sequence =\n  $('Determine Follow-Up Sequence').all()[$itemIndex].json.follow_up_number;\n\nreturn {\n  json: {\n    ...$json,\n    follow_up_number: sequence,\n    follow_up_type: followUpType,\n    follow_up_priority: priority,\n    follow_up_subject: subject,\n    follow_up_message: message,\n    follow_up_recommendation: recommendation\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        -16
      ],
      "id": "01d7a5b8-c69e-4de7-a200-06090c0b7e2e",
      "name": "Parse Follow-Up Strategy"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Check Follow-Up Eligibility').item.json.email }}",
        "subject": "={{ $('Parse Follow-Up Strategy').item.json.follow_up_subject }}",
        "message": "={{ $('Parse Follow-Up Strategy').item.json.follow_up_message }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1920,
        -16
      ],
      "id": "6d75c19c-ed82-40bc-9c16-48ef41db7924",
      "name": "Send AI Follow-Up",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const status = $json.Status || '';\n\nlet followUpNumber = 1;\n\nif (\n  status === 'AI Follow-Up Sent' ||\n  status === 'Follow-Up #1 Sent'\n) {\n  followUpNumber = 2;\n} else if (status === 'Follow-Up #2 Sent') {\n  followUpNumber = 3;\n} else if (status === 'Follow-Up #3 Sent') {\n  followUpNumber = 4;\n} else if (status === 'Follow-Up #4 Sent') {\n  followUpNumber = 5;\n}\n\nreturn {\n  json: {\n    ...$json,\n    follow_up_number: followUpNumber\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        128
      ],
      "id": "7f67a17d-4681-4565-a6b1-02594457dd04",
