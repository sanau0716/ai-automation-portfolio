      "parameters": {
        "jsCode": "const parts = $json.content?.parts || [];\n\nconst textPart = parts.find(\n  part => typeof part.text === 'string' &&\n          part.text.trim().startsWith('{')\n);\n\nif (!textPart) {\n  throw new Error('No JSON response found from Gemini');\n}\n\nconst parsed = JSON.parse(textPart.text);\n\n// Normalize urgency for reliable routing\nif (parsed.urgency) {\n  parsed.urgency = parsed.urgency.toUpperCase();\n}\n\nreturn {\n  json: Array.isArray(parsed) ? parsed[0] : parsed\n};"
      },
