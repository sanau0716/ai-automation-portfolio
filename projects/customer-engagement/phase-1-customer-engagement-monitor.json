    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n\n  // Get the AI response\n  const aiText = item.json.output[0].content[0].text;\n  const analysis = JSON.parse(aiText);\n\n  // Get the original customer data from the earlier Edit Fields node\n  const customer = $('Prepare Customer Data').item.json;\n\n  // Combine customer data and AI analysis\n  item.json = {\n    ...customer,\n    ...analysis,\n  };\n}\n\nreturn items;"
      },
