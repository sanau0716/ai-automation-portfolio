            },
            {
              "id": "f2",
              "name": "email",
              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "phone",
              "value": "={{ $json.phone || \"\" }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "company",
              "value": "={{ $json.company || \"Unspecified\" }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "source",
