        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "fieldType": "text",
              "fieldName": "name",
              "placeholder": "Jordan Rivera",
              "defaultValue": "",
              "requiredField": true
            },
            {
              "fieldLabel": "Work Email",
              "fieldType": "email",
              "fieldName": "email",
              "placeholder": "name@company.com",
              "defaultValue": "",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone (Optional)",
              "fieldType": "text",
              "fieldName": "phone",
              "placeholder": "+61 400 000 000",
              "defaultValue": "",
              "requiredField": false
            },
            {
              "fieldLabel": "Company (Optional)",
              "fieldType": "text",
              "fieldName": "company",
              "placeholder": "Harbor Property Group",
              "defaultValue": "",
              "requiredField": false
            },
            {
              "fieldLabel": "Channel Source",
              "fieldType": "dropdown",
              "fieldName": "source",
              "defaultValue": "Web Form",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Web Form"
                  },
                  {
                    "option": "Missed Call"
                  },
                  {
                    "option": "Email"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Preferred Call Slot (ISO, optional)",
              "fieldType": "text",
              "fieldName": "requested_slot",
              "placeholder": "2026-11-28T10:00:00+08:00",
              "defaultValue": "",
              "requiredField": false
            },
            {
              "fieldLabel": "Inquiry Details",
              "fieldType": "textarea",
              "fieldName": "inquiry_text",
              "placeholder": "Describe what you need help with...",
              "defaultValue": "",
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Submit Inquiry",
          "path": "zero-leak-intake",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thank you. Your inquiry has been persisted safely and queued for executive review."
            }
          }
        }
      },
      "webhookId": "<YOUR_WEBHOOK_ID>"
    },
    {
      "id": "88a73470-9bae-46f6-81c1-04a91dd99052",
