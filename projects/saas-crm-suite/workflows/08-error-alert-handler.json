    {
      "id": "8af2b12e-9c29-45a7-943e-84ebf0833914",
      "name": "Format Production Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        460,
        200
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "ec",
              "name": "event_code",
              "type": "string",
              "value": "={{ \"ERR-\" + ($json.execution?.id || $execution.id || \"RUN\") }}"
            },
            {
              "id": "et",
              "name": "entity_type",
              "type": "string",
              "value": "system"
            },
            {
              "id": "ek",
              "name": "entity_key",
              "type": "string",
              "value": "={{ $json.workflow?.id || $workflow.id }}"
            },
            {
              "id": "ac",
              "name": "actor",
              "type": "string",
              "value": "error_handler"
            },
            {
              "id": "ev",
              "name": "event_type",
              "type": "string",
              "value": "PRODUCTION_ERROR"
            },
            {
              "id": "sm",
              "name": "summary",
              "type": "string",
              "value": "={{ ($json.workflow?.name || \"SaaS CRM Workflow\") + \" failed at \" + ($json.execution?.lastNodeExecuted || \"Unknown Node\") + \": \" + ($json.execution?.error?.message || \"Runtime failure\") }}"
            },
            {
              "id": "es",
              "name": "email_subject",
              "type": "string",
              "value": "={{ \"[SaaS CRM Error] \" + ($json.workflow?.name || \"System Alert\") }}"
            },
            {
              "id": "eh",
              "name": "email_html",
              "type": "string",
              "value": "={{ '<h2>SaaS CRM SaaS CRM — Production Workflow Error</h2><p><strong>Workflow:</strong> ' + ($json.workflow?.name || 'Unknown') + ' (' + ($json.workflow?.id || 'N/A') + ')</p><p><strong>Execution ID:</strong> ' + ($json.execution?.id || 'N/A') + '</p><p><strong>Last Node:</strong> ' + ($json.execution?.lastNodeExecuted || 'N/A') + '</p><p><strong>Error:</strong> ' + ($json.execution?.error?.message || 'No error message supplied') + '</p><p><a href=\"' + ($json.execution?.url || 'https://n8n.example.com') + '\">Inspect Execution in n8n</a></p>' }}"
            },
            {
              "id": "sl",
              "name": "slack_message",
              "type": "string",
              "value": "={{ \":rotating_light: *SaaS CRM Production Error*\\n*Workflow:* \" + ($json.workflow?.name || \"Unknown\") + \"\\n*Node:* \" + ($json.execution?.lastNodeExecuted || \"Unknown\") + \"\\n*Error:* \" + ($json.execution?.error?.message || \"No message\") + \"\\n<\" + ($json.execution?.url || \"https://n8n.example.com\") + \"|Inspect Execution>\" }}"
            },
            {
              "id": "ca",
              "name": "created_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "dj",
              "name": "details_json",
              "type": "string",
              "value": "={{ JSON.stringify({ workflowId: $json.workflow?.id || null, executionId: $json.execution?.id || null, lastNode: $json.execution?.lastNodeExecuted || null, error: $json.execution?.error?.message || null }) }}"
            }
          ]
        }
      }
    },
