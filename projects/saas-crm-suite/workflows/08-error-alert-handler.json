            {
              "id": "eh",
              "name": "email_html",
              "type": "string",
              "value": "<h2>SaaS CRM SaaS CRM — Error Handler Test</h2><p>This confirms SMTP, Slack, Data Table, and Google Sheet logging are operational for the SaaS CRM suite.</p>"
            },
            {
              "id": "sl",
              "name": "slack_message",
              "type": "string",
