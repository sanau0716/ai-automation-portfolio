{
  "name": "SaaS CRM — Customer Onboarding & Account Provisioning",
  "nodes": [
    {
      "id": "f574af17-8265-416a-93d1-7d99540b5f66",
      "name": "Customer Onboarding Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        100,
        140
      ],
      "parameters": {
        "formDescription": "Provision a new paid SaaS customer account, assign subscription plan & MRR, mark matching CRM lead as converted, and trigger welcome onboarding.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Customer Name",
              "fieldType": "text",
              "placeholder": "Elena Vance",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "placeholder": "elena@cloudscale.io",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "fieldType": "text",
              "placeholder": "CloudScale IO",
              "requiredField": true
            },
            {
              "fieldLabel": "Subscription Plan",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Starter ($99/mo)"
                  },
                  {
                    "option": "Growth ($299/mo)"
                  },
                  {
                    "option": "Scale ($699/mo)"
                  },
                  {
                    "option": "Enterprise ($1499/mo)"
                  }
                ]
              },
              "fieldType": "dropdown",
              "requiredField": true
            },
            {
              "fieldLabel": "Monthly MRR USD",
              "fieldType": "number",
              "placeholder": "299",
              "requiredField": false
            },
            {
              "fieldLabel": "Onboarding Notes",
              "fieldType": "textarea",
              "placeholder": "Kickoff date, priority workflows, or billing contact notes.",
              "requiredField": false
            }
          ]
        },
        "formTitle": "SaaS CRM SaaS CRM — Customer Onboarding",
        "options": {
          "appendAttribution": false
        },
        "responseMode": "onReceived"
      }
    },
    {
      "id": "5439e85f-58f4-4e82-ae1c-62e91c924f22",
      "name": "Webhook — Onboard Customer API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        100,
        380
      ],
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "options": {},
        "path": "crm/v1/customers/onboard",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "5f0fcbad-104b-49d7-8bfc-c539d8c611d8",
      "name": "Normalize Onboarding Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        260
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json || {};\nconst body = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst isWebhook = Boolean(raw.headers || raw.body);\n\nconst name = String(body['Customer Name'] ?? body.name ?? body.customer_name ?? '').trim();\nconst email = String(body.Email ?? body.email ?? body.customer_email ?? '').trim().toLowerCase();\nconst company = String(body.Company ?? body.company ?? '').trim() || 'Direct Account';\nconst rawPlan = String(body['Subscription Plan'] ?? body.subscription_plan ?? body.plan ?? 'Growth ($299/mo)').trim();\nconst notes = String(body['Onboarding Notes'] ?? body.notes ?? '').trim();\n\nconst planCatalog = [\n  { key: 'Starter', regex: /starter/i, mrr: 99 },\n  { key: 'Growth', regex: /growth/i, mrr: 299 },\n  { key: 'Scale', regex: /scale/i, mrr: 699 },\n  { key: 'Enterprise', regex: /enterprise/i, mrr: 1499 },\n];\nconst matched = planCatalog.find((p) => p.regex.test(rawPlan)) || planCatalog[1];\nconst overrideMrr = Number(body['Monthly MRR USD'] ?? body.mrr_usd ?? body.mrr);\nconst mrrUsd = (!Number.isNaN(overrideMrr) && overrideMrr > 0) ? Math.round(overrideMrr) : matched.mrr;\n\nconst emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst isValid = emailValid && name.length >= 2;\nconst nowIso = new Date().toISOString();\n\nlet hash = 0;\nfor (let i = 0; i < email.length; i++) {\n  hash = ((hash << 5) - hash) + email.charCodeAt(i);\n  hash |= 0;\n}\nconst shortHex = Math.abs(hash).toString(16).toUpperCase().padStart(6, '0').slice(0, 6);\nconst customerCode = String(body.customer_code || `CUST-${shortHex}`).trim().toUpperCase();\nconst escHtml = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst welcomeHtml = `\n<div style=\"font-family:Inter,Segoe UI,Arial,sans-serif;max-width:600px;margin:0 auto;color:#111827;line-height:1.6;\">\n  <h2 style=\"color:#0f172a;margin-bottom:8px;\">Welcome to SaaS CRM, ${escHtml(name)}!</h2>\n  <p>Your <strong>${escHtml(matched.key)}</strong> SaaS workspace for <strong>${escHtml(company)}</strong> is now provisioned and active.</p>\n  <div style=\"background:#f0fdf4;border-left:4px solid #16a34a;padding:12px 16px;margin:16px 0;border-radius:6px;\">\n    <strong>Account Summary</strong><br>\n    Customer Code: <code>${escHtml(customerCode)}</code><br>\n    Plan: ${escHtml(matched.key)} (\\$${mrrUsd}/mo)<br>\n    Status: Active\n  </div>\n  ${notes ? `<p><strong>Onboarding Notes:</strong> ${escHtml(notes)}</p>` : ''}\n  <p>Reply directly to this email anytime you need workflow adjustments or priority onboarding support.</p>\n  <p style=\"margin-top:20px;\">Best regards,<br><strong>Operator Name</strong><br>SaaS CRM Solutions</p>\n</div>`.trim();\n\nreturn {\n  json: {\n    trigger_source: isWebhook ? 'webhook' : 'form',\n    is_valid: isValid,\n    validation_error: isValid ? '' : 'Valid customer name and email are required.',\n    customer_key: email,\n    customer_code: customerCode,\n    name,\n    email,\n    company,\n    subscription_plan: matched.key,\n    mrr_usd: mrrUsd,\n    account_status: 'Active',\n    last_active_days: 0,\n    open_tickets_count: 0,\n    total_tickets_count: 0,\n    current_risk_level: 'HEALTHY',\n    engagement_trend: 'NEW_ONBOARDING',\n    risk_score: 5,\n    last_reason: 'Newly onboarded active SaaS subscription account.',\n    recommended_action: 'Schedule kickoff check-in at Day 7 to confirm workflow adoption.',\n    onboarded_at: nowIso,\n    last_analyzed_at: nowIso,\n    updated_at: nowIso,\n    notes,\n    event_code: `ONB-${Date.now().toString(36).toUpperCase()}`,\n    welcome_html: welcomeHtml,\n    slack_message: `:tada: *New SaaS Customer Onboarded*\\n*Customer:* ${name} (${company})\\n*Code:* ${customerCode} | *Plan:* ${matched.key} (\\$${mrrUsd}/mo)\\n*Email:* ${email}`,\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
