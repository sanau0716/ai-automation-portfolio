    {
      "id": "2a3816b1-fc28-4fd7-802a-56569f6c4d44",
      "name": "Select Due Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        260
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\nconst nowIso = new Date(now).toISOString();\nconst out = [];\n\nfor (const item of items) {\n  const row = item.json || {};\n  const leadKey = String(row.lead_key || '').trim();\n  const email = String(row.email || '').trim().toLowerCase();\n  if (!leadKey || !email || !email.includes('@')) continue;\n\n  const status = String(row.pipeline_status || '');\n  const convertedAt = String(row.converted_at || '').trim();\n  if (convertedAt || /converted|closed|manual review|unsubscribed|intake_received/i.test(status)) {\n    continue;\n  }\n\n  const currentCount = Number(row.followup_count || 0);\n  const lastTouchStr = row.last_contacted_at || row.updated_at || row.created_at || nowIso;\n  const lastTouchMs = new Date(lastTouchStr).getTime();\n  const daysElapsed = Number.isNaN(lastTouchMs) ? 0 : Math.floor((now - lastTouchMs) / 86400000);\n\n  if (currentCount >= 4) {\n    if (daysElapsed >= 7) {\n      out.push({\n        json: {\n          ...row,\n          lead_key: leadKey,\n          email,\n          action: 'escalate_manual_review',\n          days_since_contact: daysElapsed,\n          next_followup_number: currentCount,\n          updated_at: nowIso,\n          event_code: `ESC-${Date.now().toString(36).toUpperCase()}-${out.length}`,\n        },\n      });\n    }\n    continue;\n  }\n\n  const nextStep = Math.max(2, currentCount + 1);\n  const requiredDays = nextStep === 2 ? 2 : (nextStep === 3 ? 4 : 7);\n  if (daysElapsed >= requiredDays) {\n    out.push({\n      json: {\n        ...row,\n        lead_key: leadKey,\n        email,\n        action: 'send_followup',\n        days_since_contact: daysElapsed,\n        next_followup_number: nextStep,\n        updated_at: nowIso,\n      },\n    });\n  }\n}\n\nreturn out;",
        "mode": "runOnceForAllItems"
      }
    },
    {
