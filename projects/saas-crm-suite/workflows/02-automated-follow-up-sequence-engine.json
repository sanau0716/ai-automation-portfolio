            "version": 2
          }
        },
        "options": {}
      }
    },
    {
      "id": "51ff1745-fa10-489b-97b3-57ea5ab3c3ff",
      "name": "AI Follow-Up Strategist",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1160,
        140
      ],
      "parameters": {
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a consultative B2B SaaS Growth Advisor for SaaS CRM. Write non-pushy, context-aware follow-up emails tailored to the lead's original inquiry and step number (step 2 = value insight, step 3 = brief automation ROI case study, step 4 = polite close-the-loop note). Plain text body without greeting or signature lines."
        },
        "promptType": "define",
        "text": "=Draft follow-up touch #{{ $json.next_followup_number }} for this lead:\\n\\nName: {{ $json.name }}\\nCompany: {{ $json.company }}\\nScore: {{ $json.lead_score }}/100 ({{ $json.classification }})\\nOriginal Inquiry: {{ $json.inquiry_message }}\\nPrevious Recommendation: {{ $json.recommended_action }}\\nDays Since Last Contact: {{ $json.days_since_contact }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "67869048-4900-4591-84f4-ef91826a2211",
      "name": "OpenRouter Follow-Up LLM",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1120,
        360
      ],
      "parameters": {
        "model": "google/gemini-3.1-flash-lite",
        "options": {
          "maxTokens": 900,
          "temperature": 0.3
        }
      }
    },
    {
      "id": "4b3cc085-4e66-4021-8a51-3b20f2a0d1c0",
      "name": "Follow-Up Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1300,
        360
      ],
      "parameters": {
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"cta\":{\"type\":\"string\"}},\"required\":[\"subject\",\"body\",\"cta\"],\"additionalProperties\":false}",
        "schemaType": "manual"
      }
    },
    {
      "id": "b8068783-7537-4199-b93a-153afe0ac0f9",
      "name": "Format Follow-Up Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        140
      ],
      "parameters": {
        "jsCode": "const lead = $('Should Send Follow-Up?').item.json;\nconst raw = $input.item.json || {};\nconst ai = (raw.output && typeof raw.output === 'object') ? raw.output : raw;\nconst step = Number(lead.next_followup_number || 2);\nconst escHtml = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst subject = String(ai.subject || `Checking in on automation goals at ${lead.company} (Follow-Up #${step})`).trim();\nconst body = String(ai.body || `I wanted to follow up briefly regarding your inquiry for ${lead.company}. Let us know if mapping out an initial automation workflow this week makes sense.`).trim();\nconst cta = String(ai.cta || 'Reply with two 15-minute windows that work for your team.').trim();\n\nconst html = `\n<div style=\"font-family:Inter,Segoe UI,Arial,sans-serif;max-width:600px;margin:0 auto;color:#111827;line-height:1.6;\">\n  <p>Hi ${escHtml(lead.name)},</p>\n  <p>${escHtml(body).replace(/\\n/g, '<br>')}</p>\n  <p><strong>${escHtml(cta)}</strong></p>\n  <p style=\"margin-top:20px;\">Best,<br><strong>Operator Name</strong><br>SaaS CRM Solutions</p>\n</div>`.trim();\n\nreturn {\n  json: {\n    ...lead,\n    email_subject: subject,\n    email_html: html,\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "feed0de3-3003-48b3-9f0b-0fb01e304468",
      "name": "Send Follow-Up Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1720,
        140
      ],
      "parameters": {
        "emailFormat": "html",
        "fromEmail": "SaaS CRM SaaS CRM <crm-notifications@example.com>",
        "html": "={{ $json.email_html }}",
        "operation": "send",
        "options": {
          "appendAttribution": false,
          "replyTo": "crm-notifications@example.com"
        },
        "resource": "email",
        "subject": "={{ $json.email_subject }}",
        "toEmail": "={{ $json.email }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "61e2d2bf-0245-4e25-905d-c63faa57c991",
      "name": "Resolve Send Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        140
      ],
      "parameters": {
        "jsCode": "const lead = $('Format Follow-Up Email').item.json;\nconst sendRes = $input.item.json || {};\nconst sentOk = Array.isArray(sendRes.accepted) ? sendRes.accepted.length > 0 : !sendRes.error;\nconst nowIso = new Date().toISOString();\nconst nextStep = Number(lead.next_followup_number || 2);\n\nreturn {\n  json: {\n    lead_key: lead.lead_key,\n    name: lead.name,\n    email: lead.email,\n    followup_count: sentOk ? nextStep : Number(lead.followup_count || 1),\n    pipeline_status: sentOk ? `Follow-Up #${nextStep} Sent` : 'Follow-Up Email Failed',\n    last_contacted_at: sentOk ? nowIso : (lead.last_contacted_at || nowIso),\n    updated_at: nowIso,\n    event_code: `FU-${nextStep}-${Date.now().toString(36).toUpperCase()}`,\n    event_type: sentOk ? 'FOLLOWUP_SENT' : 'FOLLOWUP_FAILED',\n    summary: sentOk ? `Sent Follow-Up #${nextStep} to ${lead.name} (${lead.company})` : `Follow-Up #${nextStep} failed for ${lead.email}: ${sendRes.error?.message || 'SMTP error'}`,\n    details_json: JSON.stringify({ step: nextStep, sentOk, messageId: sendRes.messageId || null, error: sendRes.error || null }),\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
