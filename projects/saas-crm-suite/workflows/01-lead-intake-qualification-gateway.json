    {
      "id": "f9be8ead-b151-470e-81e7-6662d3824a95",
      "name": "Lead Qualification Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"lead_score\":{\"type\":\"number\",\"minimum\":0,\"maximum\":100},\"classification\":{\"type\":\"string\",\"enum\":[\"High-Value Lead\",\"Qualified Lead\",\"Potential Lead\",\"Low-Quality Lead\"]},\"urgency\":{\"type\":\"string\",\"enum\":[\"HIGH\",\"MEDIUM\",\"LOW\"]},\"reason\":{\"type\":\"string\"},\"recommended_action\":{\"type\":\"string\"},\"personalized_subject\":{\"type\":\"string\"},\"personalized_body\":{\"type\":\"string\"}},\"required\":[\"lead_score\",\"classification\",\"urgency\",\"reason\",\"recommended_action\",\"personalized_subject\",\"personalized_body\"],\"additionalProperties\":false}",
        "schemaType": "manual"
      }
    },
    {
      "id": "3b487ddc-d4fd-4007-8b45-679b6c075e79",
      "name": "Finalize Lead Assessment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        180
      ],
      "parameters": {
        "jsCode": "const lead = $('Normalize & Validate Lead').item.json;\nconst raw = $input.item.json || {};\nconst ai = (raw.output && typeof raw.output === 'object') ? raw.output : raw;\n\nconst parsedScore = Number(ai.lead_score);\nconst aiFailed = Boolean(raw.error) || Number.isNaN(parsedScore);\nconst leadScore = aiFailed ? 55 : Math.max(0, Math.min(100, Math.round(parsedScore)));\n\nlet classification = String(ai.classification || '').trim();\nif (aiFailed || !['High-Value Lead', 'Qualified Lead', 'Potential Lead', 'Low-Quality Lead'].includes(classification)) {\n  if (leadScore >= 80) classification = 'High-Value Lead';\n  else if (leadScore >= 60) classification = 'Qualified Lead';\n  else if (leadScore >= 40) classification = 'Potential Lead';\n  else classification = 'Low-Quality Lead';\n}\n\nlet urgency = String(ai.urgency || '').trim().toUpperCase();\nif (!['HIGH', 'MEDIUM', 'LOW'].includes(urgency)) {\n  urgency = leadScore >= 80 ? 'HIGH' : (leadScore >= 50 ? 'MEDIUM' : 'LOW');\n}\n\nconst statusMap = {\n  'High-Value Lead': 'High-Value — Priority Alert',\n  'Qualified Lead': 'Qualified — Active Nurture',\n  'Potential Lead': 'Potential — Sequence Enrolled',\n  'Low-Quality Lead': 'Low-Quality — Automated Nurture',\n};\n\nconst reason = String(ai.reason || (aiFailed ? 'AI qualification fallback applied — queued for review.' : 'Evaluated via automated SaaS CRM intake.')).trim();\nconst recommendedAction = String(ai.recommended_action || (leadScore >= 80 ? 'Schedule executive discovery call within 4 business hours.' : 'Send tailored capability deck and enroll in follow-up cadence.')).trim();\nconst pipelineStatus = aiFailed ? 'Manual Review Required' : statusMap[classification];\nconst nowIso = new Date().toISOString();\n\nconst escHtml = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst safeSubject = String(ai.personalized_subject || `Next steps for ${lead.company} — SaaS CRM`).trim();\nconst defaultBody = `Thank you for reaching out to SaaS CRM regarding ${lead.company}. We reviewed your inquiry and would love to walk through how we can streamline your operations.`;\nconst safeBody = String(ai.personalized_body || defaultBody).trim();\n\nconst emailHtml = `\n<div style=\"font-family:Inter,Segoe UI,Arial,sans-serif;max-width:600px;margin:0 auto;color:#111827;line-height:1.6;\">\n  <h2 style=\"color:#0f172a;margin-bottom:8px;\">Hi ${escHtml(lead.name)},</h2>\n  <p>${escHtml(safeBody).replace(/\\n/g, '<br>')}</p>\n  <div style=\"background:#f8fafc;border-left:4px solid #2563eb;padding:12px 16px;margin:16px 0;border-radius:6px;\">\n    <strong>Recommended Next Step:</strong><br>${escHtml(recommendedAction)}\n  </div>\n  <p style=\"margin-top:20px;\">Best regards,<br><strong>Operator Name</strong><br>SaaS CRM Solutions</p>\n</div>`.trim();\n\nreturn {\n  json: {\n    trigger_source: lead.trigger_source,\n    lead_key: lead.lead_key,\n    name: lead.name,\n    email: lead.email,\n    phone: lead.phone,\n    company: lead.company,\n    source: lead.source,\n    inquiry_message: lead.inquiry_message,\n    lead_score: leadScore,\n    classification,\n    urgency,\n    reason,\n    recommended_action: recommendedAction,\n    pipeline_status: pipelineStatus,\n    followup_count: 1,\n    last_contacted_at: nowIso,\n    created_at: lead.created_at,\n    updated_at: nowIso,\n    email_subject: safeSubject,\n    email_html: emailHtml,\n    event_code: `LEAD-${Date.now().toString(36).toUpperCase()}`,\n    slack_message: `:fire: *High-Value Lead Captured (${leadScore}/100)*\\n*Name:* ${lead.name} (${lead.company})\\n*Email:* ${lead.email}\\n*Source:* ${lead.source}\\n*Reason:* ${reason}\\n*Next Action:* ${recommendedAction}`,\n    admin_alert_html: `<h2>High-Value Lead Alert — ${leadScore}/100</h2><p><strong>Name:</strong> ${escHtml(lead.name)}</p><p><strong>Company:</strong> ${escHtml(lead.company)}</p><p><strong>Email:</strong> ${escHtml(lead.email)}</p><p><strong>Source:</strong> ${escHtml(lead.source)}</p><p><strong>Reason:</strong> ${escHtml(reason)}</p><p><strong>Recommended Action:</strong> ${escHtml(recommendedAction)}</p><p><strong>Inquiry:</strong> ${escHtml(lead.inquiry_message)}</p>`,\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
