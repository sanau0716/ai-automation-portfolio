    {
      "id": "537caf17-512c-4000-afea-162c01d91fe0",
      "name": "Normalize & Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        260
      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json || {};\nconst body = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst isWebhook = Boolean(raw.headers || raw.body);\n\nconst name = String(body.Name ?? body.name ?? body.full_name ?? '').trim();\nconst emailRaw = String(body.Email ?? body.email ?? body.work_email ?? '').trim().toLowerCase();\nconst company = String(body.Company ?? body.company ?? body.organization ?? '').trim() || 'Independent / Unspecified';\nconst phone = String(body.Phone ?? body.phone ?? '').trim();\nconst source = String(body.Source ?? body.source ?? (isWebhook ? 'API Webhook' : 'Web Form')).trim();\nconst inquiryMessage = String(body['Inquiry Message'] ?? body.inquiry_message ?? body.message ?? body.inquiry ?? '').trim();\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst hasValidEmail = emailRegex.test(emailRaw);\nconst hasInquiry = inquiryMessage.length >= 3;\nconst isValid = hasValidEmail && hasInquiry;\n\nconst cleanName = name || (hasValidEmail ? emailRaw.split('@')[0] : 'Valued Prospect');\nconst leadKey = String(body.lead_key || emailRaw || `invalid-${Date.now()}`).trim().toLowerCase();\nconst nowIso = new Date().toISOString();\n\nreturn {\n  json: {\n    trigger_source: isWebhook ? 'webhook' : 'form',\n    is_valid: isValid,\n    validation_error: isValid ? '' : (!hasValidEmail ? 'A valid email address is required.' : 'Inquiry message must be at least 3 characters.'),\n    lead_key: leadKey,\n    name: cleanName,\n    email: emailRaw,\n    company,\n    phone,\n    source,\n    inquiry_message: inquiryMessage,\n    pipeline_status: 'INTAKE_RECEIVED',\n    followup_count: 0,\n    created_at: nowIso,\n    updated_at: nowIso,\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
