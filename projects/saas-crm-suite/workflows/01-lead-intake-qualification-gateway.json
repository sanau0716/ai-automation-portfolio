    {
      "id": "af5e2b35-0b55-4086-8e0d-7b76c7d4696f",
      "name": "AI Lead Qualification Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1180,
        180
      ],
      "parameters": {
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert B2B SaaS Lead Qualification Strategist for SaaS CRM. Score inbound leads objectively from 0-100 based on budget, urgency, authority, pain clarity, and fit for AI workflow automation. Draft a concise, natural, personalized outreach email body (plain text paragraphs, no greeting or signature lines) plus subject line. Never invent unstated facts."
        },
        "promptType": "define",
        "text": "=Evaluate this inbound lead for SaaS CRM SaaS CRM:\\n\\nName: {{ $('Normalize & Validate Lead').item.json.name }}\\nEmail: {{ $('Normalize & Validate Lead').item.json.email }}\\nCompany: {{ $('Normalize & Validate Lead').item.json.company }}\\nPhone: {{ $('Normalize & Validate Lead').item.json.phone || 'Not provided' }}\\nSource: {{ $('Normalize & Validate Lead').item.json.source }}\\nInquiry Message:\\n{{ $('Normalize & Validate Lead').item.json.inquiry_message }}\\n\\nScoring rubric:\\n- 80-100: High-Value Lead (explicit budget/enterprise scale/urgent automation need)\\n- 60-79: Qualified Lead (clear business pain & intent)\\n- 40-59: Potential Lead (early exploration, vague scope)\\n- 0-39: Low-Quality Lead (spam, irrelevant, student/hobbyist with zero buyer signal)"
      },
      "onError": "continueRegularOutput"
    },
    {
