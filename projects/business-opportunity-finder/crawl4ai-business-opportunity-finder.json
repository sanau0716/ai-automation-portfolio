    {
      "parameters": {
        "jsCode": "const aiText = $input.first().json.text;\n\nconst data = JSON.parse(aiText);\n\nreturn [\n  {\n    json: {\n      business_name: data.business_name,\n      industry: data.industry,\n      website: data.website,\n      overall_score: data.overall_score,\n      opportunity_1: data.opportunity_1,\n      opportunity_2: data.opportunity_2,\n      opportunity_3: data.opportunity_3,\n      opportunity_4: data.opportunity_4,\n      opportunity_5: data.opportunity_5,\n      audit_date: new Date().toISOString()\n    }\n  }\n];"
      },
